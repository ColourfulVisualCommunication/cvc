# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Every variable below is read by config.py. Postgres is required in every
# environment, including local dev — there is no SQLite fallback.

FLASK_ENV=development

# Two independent random secrets — do not reuse one for the other.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# --- Database: Supabase Postgres ---
# From the Supabase dashboard: Project Settings -> Database -> Connection string (URI).
# Use the "Session pooler" (port 5432), not the "Transaction pooler" (6543) —
# Flask on Render is a long-running process holding persistent connections,
# not a serverless function making short-lived ones.
# If the password contains @, :, / or similar, URL-encode it.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Comma-separated list of origins allowed to call the API.
# Add the real domain once the frontend is deployed, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://colourfulvisualcommunication.com
CORS_ORIGINS=http://localhost:5173

# The frontend's public base URL — used to build the signed quote/project
# links that get emailed and sent over WhatsApp (rule 4: no client passwords).
# Local dev: the Vite dev server. Production: the real domain.
FRONTEND_URL=http://localhost:5173

# --- Cloudinary: image upload (portfolio, blog, deliverables) ---
# From the Cloudinary dashboard home page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Brevo: the six transactional emails ---
# From Brevo: Settings -> SMTP & API -> API Keys. Sender must be a verified
# sender/domain in Brevo or sends will be rejected.
BREVO_API_KEY=
EMAIL_FROM=njoroge@colourfulvisualcommunication.com
EMAIL_FROM_NAME=CVC

# --- M-Pesa Daraja: phase 5. Leave blank until then. ---
# sandbox while testing, production once live on real money.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be a publicly reachable HTTPS URL — Safaricom cannot call localhost.
# For local dev: `ngrok http 5000`, then paste the printed https forwarding
# URL here + /api/v1/payments/mpesa/callback. Free ngrok URLs are ephemeral —
# it changes every time the tunnel restarts, so re-paste it each dev session.
# In production this becomes the real Render URL instead.
MPESA_CALLBACK_URL=
